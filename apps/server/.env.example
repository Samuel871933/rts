PORT=3001
CORS_ORIGIN=http://localhost:5173
# Required in production (32+ random characters, e.g. `openssl rand -hex 48`).
# Left empty in dev: a random secret is generated once into data/jwt-secret.
# JWT_SECRET=
JWT_EXPIRES_IN=7d
# Number of reverse proxies in front of the API (for client IPs in rate limits).
# TRUST_PROXY=1

# sqlite (default, zero setup) or mysql (MySQL / MariaDB)
DB_DIALECT=sqlite
DB_STORAGE=./data/macrogod.sqlite

# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=macrogod
# DB_USER=root
# DB_PASSWORD=
