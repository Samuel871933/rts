{
  "name": "macrogod",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev -w @macrogod/server\" \"npm:dev -w @macrogod/client\"",
    "dev:api": "npm run dev -w @macrogod/server",
    "dev:web": "npm run dev -w @macrogod/client",
    "build": "npm run build -w @macrogod/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @macrogod/shared"
  },
  "devDependencies": {
    "concurrently": "9.1.0",
    "typescript": "5.6.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
